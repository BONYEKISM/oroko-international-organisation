# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/oroko-international

# Auth.js / NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-strong-random-secret

# App URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Password reset email (verify orokointernational.com in Resend)
RESEND_API_KEY=replace-with-resend-api-key
PASSWORD_RESET_FROM="OROKO International <no-reply@orokointernational.com>"

# Cloudinary — cloud name is public (needed by upload widget in browser)
# API key and secret are SERVER-ONLY — never add NEXT_PUBLIC_ prefix to them
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe — secret key is SERVER-ONLY, publishable key is safe for browser
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe webhook events: payment_intent.succeeded, checkout.session.completed,
# invoice.paid, customer.subscription.deleted

# PayPal — keep the client secret SERVER-ONLY. Use sandbox credentials for testing.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=-
PAYPAL_CLIENT_SECRET=-
# Configure one PayPal webhook at https://your-domain/api/webhooks/paypal with:
# PAYMENT.CAPTURE.COMPLETED, BILLING.SUBSCRIPTION.ACTIVATED,
# PAYMENT.SALE.COMPLETED, BILLING.SUBSCRIPTION.CANCELLED, BILLING.SUBSCRIPTION.SUSPENDED
# Use the single webhook ID below, or provide separate event-specific IDs instead.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_WEBHOOK_ID_CAPTURE=your-paypal-capture-webhook-id
PAYPAL_WEBHOOK_ID_SUBSCRIPTION=your-paypal-activated-webhook-id
PAYPAL_WEBHOOK_ID_COMPLETED=your-paypal-sale-webhook-id
PAYPAL_WEBHOOK_ID_CANCELLED=your-paypal-cancelled-webhook-id
PAYPAL_WEBHOOK_ID_SUSPENDED=your-paypal-suspended-webhook-id
PAYPAL_CURRENCY=EUR
